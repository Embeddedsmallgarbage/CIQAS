# DeepSeek API 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_MAX_TOKENS=4096

# SiliconFlow Embedding API 配置
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

# 模型供应商选择与 OpenAI 兼容接口配置
# LLM_PROVIDER 可选: deepseek / openai_compatible
LLM_PROVIDER=deepseek
# EMBEDDING_PROVIDER 可选: siliconflow / openai_compatible
EMBEDDING_PROVIDER=siliconflow
# 兼容 OpenAI 协议的服务示例: LM Studio / One API / OpenRouter 兼容转发层等
LMSTUDIO_BASE_URL=http://localhost:1234/v1
OPENAI_COMPATIBLE_LLM_BASE_URL=http://localhost:1234/v1
OPENAI_COMPATIBLE_LLM_API_KEY=
OPENAI_COMPATIBLE_LLM_MODEL=
OPENAI_COMPATIBLE_EMBEDDING_BASE_URL=http://localhost:1234/v1
OPENAI_COMPATIBLE_EMBEDDING_API_KEY=
OPENAI_COMPATIBLE_EMBEDDING_MODEL=text-embedding-qwen3-embedding-8b

# 向量数据库配置（相对于项目目录）
VECTOR_DB_PATH=vector_db
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# SQLite 数据库配置（相对于项目目录）
DATABASE_PATH=data/ciqas.db

# RAG 参数
MAX_CONVERSATIONS=100
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_K=3

# 日志配置（相对于项目目录）
LOG_LEVEL=INFO
LOG_FILE=logs/ciqas.log

# Flask 配置
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true

# 首次部署可选：显式引导创建默认管理员
# 留空则不会自动创建管理员账号
DEFAULT_ADMIN_ID=admin_001
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=系统管理员
